{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanoid-arena.local/schemas/robot-profile.schema.json",
  "title": "Robot Profile",
  "type": "object",
  "required": ["robot_id", "name", "company", "status", "evidence"],
  "additionalProperties": false,
  "properties": {
    "robot_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "concept", "unknown"]
    },
    "release_year": {
      "type": ["integer", "null"],
      "minimum": 1900
    },
    "specs": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "required": ["id", "tier", "category", "claim", "source_type", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "date": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "category": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
